# infra/.env の見本。値はリポジトリに入れない（7.2）。本番の値は作成者だけが扱う（7.3）

COMPOSE_PROJECT_NAME=hanamaru
STUDENT_HOST=student.hanamarumusic.com
STAFF_HOST=staff.hanamarumusic.com
MANAGE_HOST=manage.hanamarumusic.com

POSTGRES_PASSWORD=

# 検証環境は sk_test_ のキー。本番キーは作成者が本番の VPS でだけ設定する
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare R2（S3 互換）。例: https://<アカウントID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
