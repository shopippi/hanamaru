# 値の入っていない見本（7.2）。コピーして .env を作る。.env はコミットしない。
# 本番の秘密情報はここにもAIの作業環境にも置かない（7.3）。

# --- LibreBooking（infra/librebooking/compose.yml） ---
LB_DB_ROOT_PASSWORD=
LB_DATABASE_PASSWORD=
LB_INSTALL_PASSWORD=
LB_PORT=8080
# 検証環境だけ true（admin/password, user/password のダミーユーザーを作る）
LB_LOAD_SAMPLE_DATA=false
# Docker Hub のレート制限に当たる場合のみ:
# LB_IMAGE=mirror.gcr.io/librebooking/librebooking:7.1.0-3.5.1
# MARIADB_IMAGE=mirror.gcr.io/library/mariadb:11.4
