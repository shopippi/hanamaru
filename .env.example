# 値の入っていない見本（7.2）。コピーして .env を作る。.env はコミットしない。
# 本番の秘密情報はここにもAIの作業環境にも置かない（7.3）。

DATABASE_URL=postgres://hanamaru:@localhost:5432/hanamaru

# Stripe（検証環境はテストモードのキーだけ。本番キーは置かない: 7.3）
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PORTAL_CONFIGURATION_ID=

# メール送信（Resend）。空ならメールは送らずに標準出力へ書く（開発用）
RESEND_API_KEY=
MAIL_FROM=はなまる音楽教室 <no-reply@send.hanamarumusic.com>
MAIL_REPLY_TO=

# Cloudflare Turnstile（NF-06）
TURNSTILE_SECRET=
# 利用規約のページの URL（例: https://hanamarumusic.com/terms）。入会画面からリンクする
TERMS_URL=

# 各ポータルの URL（メールのリンクに使う）
STUDENT_URL=https://student.hanamarumusic.com
STAFF_URL=https://staff.hanamarumusic.com
MANAGE_URL=https://manage.hanamarumusic.com
COOKIE_SECURE=true
JOB_INTERVAL_MINUTES=5
